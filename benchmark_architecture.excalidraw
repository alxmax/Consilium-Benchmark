      "versionNonce": 155555738,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "Left -> right: one task runs through the harness in 5 modes, writes deliverables, and is graded by a script (no AI judging AI). Same model within a batch (Sonnet 5.5, or Opus 5.5) -- only the process differs.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Left -> right: one task runs through the harness in 5 modes, writes deliverables, and is graded by a script (no AI judging AI). Same model within a batch (Sonnet 5.5, or Opus 5.5) -- only the process differs.",
      "lineHeight": 1.25,
      "autoResize": true
    },
